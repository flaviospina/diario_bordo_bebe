# Segredos e ambiente
.env

# Conteúdo gerado em tempo de execução
storage/fotos/*
storage/thumbs/*
storage/pdfs/*
storage/exportacoes/*
storage/logs/*
storage/cache/*
!storage/**/.gitkeep

# Sistema operacional / editores
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Documentos trabalhistas (Portal da Colaboradora) — nunca versionar
storage/folha/*
!storage/folha/.htaccess
!storage/folha/.gitkeep
