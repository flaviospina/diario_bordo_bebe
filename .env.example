# ============================================================
# Diário do Bebê — configuração de ambiente
#
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA versione o .env real nem o deixe legível pela web.
#
# Local recomendado na HostGator (fora do webroot):
#   /home/USUARIO/diariobebe_privado/.env
# O sistema procura nesta ordem:
#   1. Caminho apontado por variável de servidor DIARIOBEBE_ENV (SetEnv)
#   2. ../../diariobebe_privado/.env  (pasta irmã de public_html)
#   3. .env na raiz do projeto (bloqueado por .htaccess)
# ============================================================

APP_AMBIENTE=producao          # producao | desenvolvimento
APP_URL=https://itthrive.com.br/diariobebe
# BASE_PATH é autodetectado; descomente apenas para forçar
# BASE_PATH=/diariobebe
APP_FUSO=America/Sao_Paulo

# Banco de dados (MySQL 8 / MariaDB)
BD_HOST=localhost
BD_PORTA=3306
BD_NOME=
BD_USUARIO=
BD_SENHA=

# Pasta de armazenamento (fotos, PDFs, logs). Se vazio, usa ./storage
# Recomendado fora do webroot: /home/USUARIO/diariobebe_privado/storage
STORAGE_PATH=

# Token do script de migração web (/install/migrate.php?token=...)
# Gere um valor longo e aleatório, ex.: openssl rand -hex 32
MIGRATE_TOKEN=

# Token dos endpoints de tarefas agendadas (/api/tarefas/{tarefa})
TAREFAS_TOKEN=

# Integração n8n (Fase 5)
N8N_WEBHOOK_URL=
N8N_API_KEY=

# E-mail transacional (recuperação de senha, convites)
EMAIL_REMETENTE=nao-responda@itthrive.com.br
EMAIL_NOME_REMETENTE="Diário do Bebê"

# Chave para HMAC de tokens internos (convites, redefinição de senha)
APP_CHAVE_SECRETA=
